# Local provisioning credentials. Never commit the filled .env.provision file.
# Supabase account access token, not a project's anon/service-role key:
# https://supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=
# Render account API key:
# https://dashboard.render.com/u/settings
RENDER_API_KEY=
# Server-only OpenAI key. May instead be configured in apps/api/.env.
OPENAI_API_KEY=

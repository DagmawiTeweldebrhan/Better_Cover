VITE_DRAFT_MODE=local
# Set VITE_DRAFT_MODE=cloud only when using the optional authenticated AI backend.
VITE_API_URL=http://localhost:3001
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-or-anon-key
# Optional stable manifest public key for a consistent extension ID across machines.
# This is a PUBLIC key, never a private signing key.
VITE_EXTENSION_PUBLIC_KEY=

{
  "name": "better-cover",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:extension": "npm run dev -w @better-cover/extension",
    "dev:api": "npm run dev -w @better-cover/api",
    "build": "npm run build --workspaces --if-present && node scripts/check-extension.mjs",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "check": "npm run typecheck && npm test && npm run build",
    "preview:test": "node scripts/preview.mjs",
    "test:e2e": "playwright test",
    "icons": "node scripts/create-icons.mjs",
    "demo": "npm run build -w @better-cover/extension && node scripts/demo.mjs",
    "check:cloud": "node scripts/check-cloud-access.mjs",
    "test:live": "npm run build -w @better-cover/api && node scripts/smoke-live.mjs"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.0.0",
    "jsdom": "^26.1.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=24"
  }
}
